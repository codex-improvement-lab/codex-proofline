{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codex-proofline:schema:goal-dependencies:v1",
  "title": "Codex Proofline Goal Delta evidence dependencies",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "evidence"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schemaVersion": { "const": "proofline-goal-dependencies/1" },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "dependsOn"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "dependsOn": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            }
          }
        }
      }
    }
  }
}


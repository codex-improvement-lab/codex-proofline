{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codex-proofline:schema:goal-contract:v1",
  "title": "Codex Proofline Goal Delta contract snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "title", "revision", "items"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schemaVersion": { "const": "proofline-goal-contract/1" },
    "title": { "type": "string", "minLength": 1 },
    "revision": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+-]*$"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "goal", "acceptance"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "goal": { "type": "string", "minLength": 1 },
          "acceptance": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    }
  }
}


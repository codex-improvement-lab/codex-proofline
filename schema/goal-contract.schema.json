{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codex-proofline:schema:goal-contract:v1",
  "title": "Codex Proofline Goal Delta contract snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "title", "revision", "items"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schemaVersion": { "const": "proofline-goal-contract/1" },
    "title": { "type": "string", "minLength": 1 },
    "revision": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+-]*$"
    },
    "intake": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "scope", "revision", "requirements"],
      "properties": {
        "schemaVersion": { "const": "proofline-intake-origin/1" },
        "scope": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$", "maxLength": 64 },
        "revision": { "type": "integer", "minimum": 1 },
        "requirements": { "type": "array", "items": {
          "type": "object", "additionalProperties": false,
          "required": ["id", "revision", "confirmation", "pointer"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "revision": { "type": "integer", "minimum": 1 },
            "confirmation": { "enum": ["candidate", "user-confirmed", "needs-review", "withdrawn"] },
            "pointer": { "$ref": "#/$defs/intakePointer" },
            "previousPointer": { "$ref": "#/$defs/intakePointer" }
          }
        } }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "goal", "acceptance"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "goal": { "type": "string", "minLength": 1 },
          "acceptance": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "intakePointer": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceId", "locator"],
      "properties": {
        "sourceId": { "$ref": "#/$defs/id" },
        "sourceRevision": { "type": "integer", "minimum": 1 },
        "locator": { "type": "string", "minLength": 1 }
      },
      "if": { "properties": { "sourceId": { "const": "USER" } } },
      "else": { "required": ["sourceRevision"] }
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    }
  }
}

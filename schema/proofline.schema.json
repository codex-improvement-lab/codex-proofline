{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codex-proofline:schema:manifest:v1",
  "title": "Codex Proofline manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "project", "criteria"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "version": { "const": 1 },
    "project": { "type": "string", "minLength": 1 },
    "defaultFreshnessHours": { "type": "number", "exclusiveMinimum": 0 },
    "ledger": { "type": "string", "minLength": 1 },
    "completionPolicy": { "enum": ["off", "warn", "enforce-once"] },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "proof"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "statement": { "type": "string", "minLength": 1 },
          "proof": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/proof" }
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "label"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["command", "file", "screenshot"] },
        "label": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "environment": { "type": "string", "minLength": 1 },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "freshnessHours": { "type": "number", "exclusiveMinimum": 0 },
        "expect": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "exitCode": { "type": "integer" }
          }
        }
      }
    }
  }
}
